---
layout: layouts/base.njk
---
{% set videoLecture = video.lecture or (video.driveId | driveLecture) %}
{% set videoFiche = video.page or (video.driveId | driveFiche) %}
<article class="page-standard">
  <div class="conteneur conteneur--texte">
    <nav class="fil-ariane" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li><a href="/videos/">Vidéos</a></li>
        <li><span aria-current="page">{{ title }}</span></li>
      </ol>
    </nav>

    <header class="page-standard__entete">
      <p class="fiche__categorie">{{ rubrique or "Vidéo" }}</p>
      <h1>{{ title }}</h1>
      {% if chapo %}<p class="chapo">{{ chapo }}</p>{% endif %}
      <p class="dossier__meta">Publié le <time datetime="{{ page.date | isoDate }}">{{ page.date | dateFr }}</time></p>
    </header>

    <div class="lecteur-video{% if (video.hauteur or 9) > (video.largeur or 16) %} lecteur-video--portrait{% endif %}"
         style="--ratio: {{ video.largeur or 16 }} / {{ video.hauteur or 9 }}">
      {% if video.fichier %}
      <video
        controls
        playsinline
        preload="metadata"
        poster="{{ video.affiche or image }}"
        width="{{ video.largeur or 16 }}"
        height="{{ video.hauteur or 9 }}">
        <source src="{{ video.fichier }}" type="video/mp4">
        Votre navigateur ne lit pas les vidéos HTML5.
        <a href="{{ video.fichier }}">Télécharger la vidéo</a>.
      </video>
      {% else %}
      <iframe
        src="{{ videoLecture }}"
        title="{{ title }}"
        allow="autoplay; fullscreen"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
      {% endif %}
    </div>
    <p class="lecteur-video__repli">
      La vidéo ne s'affiche pas ?
      <a href="{{ video.fichier or videoFiche }}" rel="noopener">Ouvrir la vidéo dans un nouvel onglet</a>.
    </p>

    <div class="prose">
      {{ content | safe }}
    </div>

    {% if sources %}
    <section class="fiche__sources" aria-labelledby="sources-titre">
      <h2 id="sources-titre">Sources et pour aller plus loin</h2>
      <ul>{% for s in sources %}<li>{{ s | safe }}</li>{% endfor %}</ul>
    </section>
    {% endif %}
  </div>
</article>

{% set ldFil = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": "Vidéos", "item": site.url + "/videos/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url }
  ]
} %}
<script type="application/ld+json">{{ ldFil | jsonify | safe }}</script>

{% set ldVideo = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description or chapo,
  "thumbnailUrl": [ site.url + (image or "/assets/img/og-defaut.png") ],
  "uploadDate": page.date | isoDate,
  "duration": video.duree,
  "embedUrl": (site.url + page.url) if video.fichier else videoLecture,
  "contentUrl": (site.url + video.fichier) if video.fichier else videoFiche,
  "publisher": { "@type": "Organization", "name": site.organisme, "url": site.url },
  "mainEntityOfPage": site.url + page.url
} %}
<script type="application/ld+json">{{ ldVideo | jsonify | safe }}</script>
