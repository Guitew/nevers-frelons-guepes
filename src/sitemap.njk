---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set pages = collections.all -%}
{%- for p in pages -%}
{%- if p.url and not p.data.eleventyExcludeFromCollections and "/index-recherche" not in p.url -%}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    {% if p.date %}<lastmod>{{ p.date | isoDate }}</lastmod>{% endif %}
    <changefreq>monthly</changefreq>
    <priority>{% if p.url == "/" %}1.0{% elif p.data.tags %}0.8{% else %}0.6{% endif %}</priority>
  </url>
{%- endif -%}
{%- endfor -%}
</urlset>
