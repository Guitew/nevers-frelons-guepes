---
pagination:
  data: annuaire.pagesCouple
  size: 1
  alias: p
permalink: "{{ p.url }}index.html"
layout: layouts/base.njk
eleventyComputed:
  titre: "{{ p.categorie.pluriel }} à {{ p.ville.nom }}{% if p.numero > 1 %} — page {{ p.numero }}{% endif %}"
  meta_titre: "{{ p.categorie.pluriel }} à {{ p.ville.nom }} : {{ p.nombre }} adresse{% if p.nombre > 1 %}s{% endif %}, horaires et avis | {{ site.nomCourt }}"
  meta_description: "{{ p.categorie.pluriel }} à {{ p.ville.nom }} ({{ p.ville.code_postal }}) : {{ p.nombre }} adresse{% if p.nombre > 1 %}s{% endif %} avec horaires d'ouverture, téléphone, note et avis Google, itinéraire{% if p.sousTypes.length > 1 %} — {% for t in p.sousTypes | limite(4) %}{{ t.libelle | lower }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}."
---
{% set ariane = [
  { titre: p.categorie.pluriel, url: "/" + p.categorie.slug + "/" },
  { titre: p.ville.nom, url: p.urlBase }
] %}
{% include "partials/ariane.njk" %}

<div class="conteneur" style="padding-block:1.5rem 3rem;">
  <header class="contenu-texte">
    <h1>{{ p.categorie.nom }} à {{ p.ville.nom }}</h1>
    {% if p.numero == 1 %}
    <p class="fiche__chapo">
      {{ p.nombre | nombreFr }} {% if p.nombre > 1 %}{{ p.categorie.pluriel | lower }}{% else %}{{ p.categorie.nom | lower }}{% endif %}
      à {{ p.ville.nom }}{% if p.ville.code_postal %} ({{ p.ville.code_postal }}){% endif %}{% if p.sousTypes.length > 1 %} :
      {% for t in p.sousTypes %}{{ t.nombre }} {{ t.libelle | lower }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}.
    </p>
    <p>Pour chaque adresse : horaires d'ouverture, téléphone, note et avis Google, itinéraire.
    Les établissements les plus commentés sont présentés en premier.</p>
    {% if p.mieuxNotees.length %}
    <p><strong>Les mieux notés à {{ p.ville.nom }}</strong> :
      {% for f in p.mieuxNotees %}<a href="{{ f.url | url }}">{{ f.nom }}</a> ({{ f.note | noteFr }}/5, {{ f.avis | nombreFr }} avis){% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {% endif %}
    {% endif %}
  </header>

  <div class="grille" style="margin-top:1.5rem;">
    {% for f in p.fiches %}{% include "partials/carte-fiche.njk" %}{% endfor %}
  </div>

  {% include "partials/pagination.njk" %}

  <section class="contenu-texte" style="margin-top:3rem;">
    <h2>Autres activités à {{ p.ville.nom }}</h2>
    <ul class="liste-liens">
      {% for c in annuaire.couples %}
        {% if c.ville.slug == p.ville.slug and c.categorie.slug != p.categorie.slug %}
        <li><a href="{{ c.url | url }}">{{ c.categorie.nom }} à {{ p.ville.nom }}</a> <span class="doux">({{ c.nombre }})</span></li>
        {% endif %}
      {% endfor %}
    </ul>
    <p style="margin-top:1rem;"><a href="{{ ("/villes/" + (p.ville.slug) + "/") | url }}">Toutes les entreprises de {{ p.ville.nom }}</a></p>
  </section>
</div>

{%- if p.numero == 1 and p.mieuxNotees.length %}
{%- set reponse = "" %}
{%- for f in p.mieuxNotees %}{% set reponse = reponse + (", " if not loop.first else "") + f.nom + " (" + (f.note | noteFr) + "/5, " + (f.avis | nombreFr) + " avis)" %}{% endfor %}
{%- set faqCouple = [{ q: "Quels sont les " + (p.categorie.pluriel | lower) + " les mieux notés à " + p.ville.nom + " ?", r: "D'après les notes Google relevées (au moins 10 avis) : " + reponse + ". Les notes évoluent : elles sont datées sur chaque fiche." }] %}
<section class="contenu-texte faq" style="margin-top:2rem;">
  <h2>Question fréquente</h2>
  {% for q in faqCouple %}<details open><summary>{{ q.q }}</summary><p>{{ q.r }}</p></details>{% endfor %}
</section>
<script type="application/ld+json">{{ faqCouple | schemaFaq | jsonify | safe }}</script>
{%- endif %}
<script type="application/ld+json">{{ { url: p.url, titre: titre, description: meta_description, fiches: p.fiches } | schemaListe | jsonify | safe }}</script>
<script type="application/ld+json">{{ ariane | schemaFil | jsonify | safe }}</script>
