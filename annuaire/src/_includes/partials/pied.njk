<footer class="pied">
  <div class="conteneur">
    <div class="pied__colonnes">
      <div>
        <h2>{{ site.nomCourt }}</h2>
        <p class="doux" style="margin:0;">{{ site.baseline }}</p>
        <p class="doux" style="margin-top:.6rem;">
          {{ annuaire.stats.fiches | nombreFr }} fiches publiées ·
          {{ annuaire.stats.categories }} catégories ·
          {{ annuaire.stats.villes }} communes
        </p>
      </div>
      <div>
        <h2>Explorer</h2>
        <ul>
          <li><a href="/categories/">Toutes les catégories</a></li>
          <li><a href="/villes/">Toutes les communes</a></li>
          <li><a href="/nouveautes/">Fiches du jour</a></li>
          <li><a href="/recherche/">Rechercher</a></li>
          <li><a href="/plan-du-site/">Plan du site</a></li>
        </ul>
      </div>
      <div>
        <h2>Catégories principales</h2>
        <ul>
          {% for c in annuaire.categories | limite(6) %}
          <li><a href="/{{ c.slug }}/">{{ c.pluriel }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h2>Le projet</h2>
        <ul>
          <li><a href="/a-propos/">Comment ça marche</a></li>
          <li><a href="/entreprises/">Vous dirigez une entreprise</a></li>
          <li><a href="/signaler/">Corriger ou retirer une fiche</a></li>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
      </div>
    </div>
    <div class="pied__bas">
      <p style="margin:0;">© {{ "" | annee }} {{ site.organisme }}. Données issues des fiches publiques Google Business Profile, datées de leur relevé.</p>
      <p style="margin:0;"><a href="/flux.xml">Flux Atom</a></p>
    </div>
  </div>
</footer>
