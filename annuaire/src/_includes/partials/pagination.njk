{% if p.total > 1 %}
<nav class="pagination" aria-label="Pagination">
  {% if p.precedente %}<a href="{{ p.precedente }}" rel="prev">← Précédent</a>{% endif %}
  {% for n in range(1, p.total + 1) %}
    {% if n == p.numero %}
      <span aria-current="page">{{ n }}</span>
    {% else %}
      <a href="{% if n == 1 %}{{ p.urlBase }}{% else %}{{ p.urlBase }}page-{{ n }}/{% endif %}">{{ n }}</a>
    {% endif %}
  {% endfor %}
  {% if p.suivante %}<a href="{{ p.suivante }}" rel="next">Suivant →</a>{% endif %}
</nav>
{% endif %}
