{# Fil d'Ariane visible + données structurées BreadcrumbList.
   « ariane » est une liste [{titre, url}] ; la dernière entrée n'est pas cliquable. #}
{% if ariane %}
<div class="conteneur">
  <nav class="ariane" aria-label="Fil d'Ariane">
    <ol>
      <li><a href="/">Accueil</a></li>
      {% for etape in ariane %}
      <li>{% if not loop.last %}<a href="{{ etape.url }}">{{ etape.titre }}</a>{% else %}<span aria-current="page">{{ etape.titre }}</span>{% endif %}</li>
      {% endfor %}
    </ol>
  </nav>
</div>
{% endif %}
