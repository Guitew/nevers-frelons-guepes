{# Carte d'entreprise réutilisée dans les listes (catégorie, ville, accueil). #}
<article class="carte">
  <p class="carte__meta">{{ f.categorie_emoji }} {{ f.categorie_nom }}</p>
  <h3 class="carte__titre"><a href="{{ f.url }}">{{ f.nom }}</a></h3>
  <p class="carte__meta">
    {% if f.adresse.rue %}{{ f.adresse.rue }} — {% endif %}{{ f.ville }}
  </p>
  <div class="carte__pied">
    {% if f.note %}<span class="etiquette etiquette--note">★ {{ f.note | noteFr }}<span class="doux" style="font-weight:400;"> ({{ f.avis | nombreFr }})</span></span>{% endif %}
    {% set resume = f.horaires | resumeHoraires %}
    {% if resume %}<span class="etiquette">{{ resume | capitalize }}</span>{% endif %}
    {% if f.telephone %}<span class="etiquette">☎ {{ f.telephone | telLisible }}</span>{% endif %}
  </div>
</article>
