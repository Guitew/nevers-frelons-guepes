# Copier ce fichier en « .env » (jamais committé) ou définir ces variables
# dans les secrets GitHub Actions.

# Clé Google Places API (New) — https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# Clé IndexNow (chaîne de 32 caractères hexadécimaux, à générer une fois).
# Le fichier <cle>.txt est publié automatiquement à la racine du site.
INDEXNOW_KEY=

# Compte de service Google (JSON encodé en base64) pour l'Indexing API — optionnel.
GOOGLE_INDEXING_SERVICE_ACCOUNT=

# Clé API Brevo — utilisée par email-suggestions.mjs pour envoyer les
# emails de suggestion de site web sur Google Maps.
BREVO_API_KEY=

# Chemin ABSOLU du fichier .htpasswd protégeant la zone de pilotage, sur le
# serveur. Une valeur erronée ferme la zone (erreur 500) plutôt que de l'ouvrir.
CHEMIN_HTPASSWD=
