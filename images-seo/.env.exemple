# Copier ce fichier en `.env` (jamais committé) ou définir ces variables dans l'environnement.

# --- Génération ---
# Fournisseur par défaut : chatgpt-navigateur | openai-api | depot | simulation
FOURNISSEUR_IMAGES=chatgpt-navigateur
# Uniquement pour le fournisseur openai-api (payant, quelques centimes par image)
OPENAI_API_KEY=

# --- Publication ---
# Mode : export (dossier sortie/ prêt à téléverser) | wordpress (API REST) — cumulables : "export,wordpress"
PUBLICATION_IMAGES=export
# Uniquement pour WordPress : identifiant + « mot de passe d'application » (Profil → Mots de passe d'application)
WP_UTILISATEUR=
WP_MOT_DE_PASSE_APPLICATION=
