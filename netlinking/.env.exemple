# Copier ce fichier en « .env » (jamais committé) ou définir ces variables
# dans les secrets GitHub Actions. TOUT est optionnel : sans clé, l'outil
# explore uniquement les graines (donnees/graines.txt) et les liens qu'il
# découvre en chemin ; les requêtes d'empreinte (« chercher ») ont besoin
# d'un moteur de recherche.

# Brave Search API — https://brave.com/search/api/ (offre gratuite : 2 000 requêtes/mois)
BRAVE_API_KEY=

# Serper.dev (résultats Google) — https://serper.dev/ (2 500 requêtes offertes)
SERPER_API_KEY=

# Google Programmable Search (JSON API, 100 requêtes/jour gratuites)
# clé : https://developers.google.com/custom-search/v1/overview
# cx  : identifiant du moteur, réglé sur « rechercher sur tout le Web »
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
