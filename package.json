{
  "name": "observatoire-biodiversite-npdc",
  "version": "1.0.0",
  "description": "Observatoire de la biodiversité du Nord et du Pas-de-Calais — encyclopédie de la faune, de la flore et des milieux naturels des Hauts-de-France.",
  "license": "MIT",
  "scripts": {
    "start": "eleventy --serve --quiet",
    "dev": "eleventy --serve",
    "build": "eleventy",
