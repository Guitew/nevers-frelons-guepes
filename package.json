    "veille-inpi": "node outils/veille-inpi.mjs",
    "test": "node --test \"outils/*.test.mjs\"",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "luxon": "^3.4.4"
  }
}
